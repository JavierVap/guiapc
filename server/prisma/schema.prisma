generator client {
  provider = "prisma-client-js"
  output   = "../generated/client-next"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  COLLABORATOR
  ADMIN
}

enum PlaceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CLIENT)
  places       Place[]
  favorites    Favorite[]
  reviews      Review[]
  events       Event[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

model Place {
  id                String      @id @default(cuid())
  nombre            String
  categoria         String
  zona              String
  direccion         String
  horario           String?
  hasDelivery       Boolean     @default(false)
  descripcion       String      @db.Text
  descripcionLarga  String?     @db.Text
  image             String?
  imageCredit       String?
  imageSource       String?
  imageLicense      String?
  imageLicenseUrl   String?
  whatsapp          String?
  isFeatured        Boolean     @default(false)
  parkingInfo       String?     @db.Text
  accessibilityInfo String?     @db.Text
  paymentMethods    String?     @db.Text
  photos            Json?
  status            PlaceStatus @default(PENDING)
  createdById       String
  createdBy         User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  menu              MenuItem[]
  favorites         Favorite[]
  reviews           Review[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([createdById, createdAt])
}

model Favorite {
  userId    String
  placeId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, placeId])
  @@index([placeId])
}

model Review {
  id        String       @id @default(cuid())
  rating    Int
  comment   String       @db.Text
  status    ReviewStatus @default(PENDING)
  userId    String
  placeId   String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place        @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, placeId])
  @@index([placeId, status])
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String      @db.Text
  startsAt    DateTime
  endsAt      DateTime?
  venue       String
  address     String
  priceInfo   String?
  image       String?
  isFeatured  Boolean     @default(false)
  status      PlaceStatus @default(PENDING)
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, startsAt])
  @@index([createdById, startsAt])
}

model MenuItem {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?  @db.Text
  precio      Decimal  @db.Decimal(10, 2)
  placeId     String
  place       Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([placeId])
}
